MONGODB_URI=mongodb://127.0.0.1:27019
MONGODB_DB=xperience_assistant
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Express port during local development. npm start uses shell PORT for the
# public web port (default 3000), and always keeps Express internal on 4000.
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional seed credentials; used only by npm run seed
SEED_EMAIL=demo@example.com
SEED_PASSWORD=
